          <label class="custom-radio">\n                            <input type="radio" name="usually_read" value="a">\n                            <span class="checkmark"></span>\n                            Có\n                        </label>\n                        <label class="custom-radio">\n                            <input type="radio" name="usually_read" value="b">\n                            <span class="checkmark"></span>\n                            Không\n                        </label>\n                    </div>\n                </div>\n                <div class="survey-footer">\n                    <button class="btn-survey btn-submit disabled jx-btn-survey-next" data-box="2">Tiếp tục</button>\n                </div>\n            </div>\n        </div>\n    \n        <div class="survey-popup survey-popup-question" id="box-survey-2a" style="display: none;">\n            <div class="survey-content">\n                <div class="close-popup"></div>\n                <div class="survey-header">\n                    <h3 class="title-survey">Khảo sát độc giả VnExpress Newsletters</h3>\n                </div>\n                <div class="survey-body">\n                    <p>Tần suất đọc VnExpress Newsletters của bạn?</p>\n                    <div class="survey-question">\n                        <label class="custom-radio">\n                            <input type="radio" name="frequency_read" value="1">\n                            <span class="checkmark"></span>\n                            Ngày nào cũng đọc\n                        </label>\n                        <label class="custom-radio">\n                            <input type="radio" name="frequency_read" value="2">\n                            <span class="checkmark"></span>\n                            Nhiều hơn 3 lần/ tuần\n                        </label>\n                        <label class="custom-radio">\n                            <input type="radio" name="frequency_read" value="3">\n                            <span class="checkmark"></span>\n                            Ít hơn 3 lần/ tuần\n                        </label>\n                    </div>\n                </div>\n                <div class="survey-footer">\n                    <button class="btn-survey btn-back jx-btn-survey-back" data-box="1">Quay lại</button>\n                    <button class="btn-survey btn-submit disabled jx-btn-survey-next" data-box="3">Tiếp tục</button>\n                </div>\n            </div>\n        </div>\n    \n        <div class="survey-popup survey-popup-question" id="box-survey-2b" style="display: none;">\n            <div class="survey-content">\n                <div class="close-popup"></div>\n                <div class="survey-header">\n                    <h3 class="title-survey">Khảo sát độc giả VnExpress Newsletters</h3>\n                </div>\n                <div class="survey-body">\n                    <p>Lý do bạn ít đọc VnExpress Newsletters?</p>\n                    <p class="note">Có thể lựa chọn nhiều đáp án</p>\n                    <div class="survey-question">\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="1">\n                            <span class="checkmark"></span>\n                            Không có thói quen đọc qua email\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="2">\n                            <span class="checkmark"></span>\n                            Quá nhiều email khiến Newsletters bị trôi\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="3">\n                            <span class="checkmark"></span>\n                            Không có nhiều thời gian đọc Newsletters vào buổi sáng\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="4">\n                            <span class="checkmark"></span>\n                            Nội dung không phù hợp\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="5">\n                            <span class="checkmark"></span>\n                            Nội dung bị cũ\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="6">\n                            <span class="checkmark"></span>\n                            Tiêu đề không thu hút\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="reason_read" value="7">\n                            <span class="checkmark"></span>\n                            Newsletters trình bày không hấp dẫn, khó đọc\n                        </label>\n                        <label class="custom-checkbox" style="flex-wrap: wrap;">\n                            <input type="checkbox" name="reason_read" value="8" data-more="1">\n                            <span class="checkmark"></span>\n                            Khác <i>(Vui lòng ghi rõ)</i>\n                        </label>\n                        <textarea class="mfp-hide input-textarea" id="2bkhac" style="min-height: 87px; width: 100%;"></textarea>\n                    </div>\n                </div>\n                <div class="survey-footer">\n                    <button class="btn-survey btn-back jx-btn-survey-back" data-box="1">Quay lại</button>\n                    <button class="btn-survey btn-submit disabled jx-btn-survey-next" data-box="3">Tiếp tục</button>\n                </div>\