mark"></span>\n                            Gửi Newsletters bằng hình thức khác (ngoài email)\n                        </label>\n                        <label class="custom-checkbox" style="flex-wrap: wrap;">\n                            <input type="checkbox" name="action_serve" value="6" data-more="1">\n                            <span class="checkmark"></span>\n                            Khác <i>(Vui lòng ghi rõ)</i>\n                        </label>\n                        <textarea class="mfp-hide input-textarea" id="3khac" style="min-height: 87px; width: 100%;"></textarea>\n                    </div>\n                </div>\n                <div class="survey-footer">\n                    <button class="btn-survey btn-back jx-btn-survey-back" data-box="2">Quay lại</button>\n                    <button class="btn-survey btn-submit disabled jx-btn-survey-next" data-box="finish">Hoàn thành</button>\n                </div>\n            </div>\n        </div>\n    \n        <div class="survey-popup survey-popup-question" id="box-survey-4" style="display: none;">\n            <div class="survey-content">\n                <div class="close-popup"></div>\n                <div class="survey-header">\n                    <h3 class="title-survey">Khảo sát độc giả VnExpress Newsletters</h3>\n                </div>\n                <div class="survey-body">\n                    <p>Thời điểm bạn muốn nhận Newsletters nhất?</p>\n                    <p class="note">Có thể lựa chọn nhiều đáp án</p>\n                    <div class="survey-question">\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="time_receive" value="1">\n                            <span class="checkmark"></span>\n                            Trước 8h sáng\n                        </label>\n                        <label class="custom-checkbox">\n                            <input type="checkbox" name="time_receive" value="2">\n              