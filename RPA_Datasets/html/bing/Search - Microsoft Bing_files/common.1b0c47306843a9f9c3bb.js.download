:host fluent-card,
:host msft-article-card {
    content-visibility: auto;
}

:host msn-info-pane::part(previous-flipper),
:host msn-info-pane::part(next-flipper),
:host msn-info-pane::part(previous-flipper):hover::before,
:host msn-info-pane::part(next-flipper):hover::before {
    opacity: 0.5;
    stroke: #FFF;
    stroke-width: 2px;
}

:host msn-info-pane::part(activeIndicator) {
    display: none;
}

:host {
    grid-template-areas:
        "slot1 slot1"
        "slot1 slot1";
}

:host([layout="C1"]) {
    grid-template-areas:
        "slot1"
        "slot1";
    grid-auto-columns: auto !important;
}
`.withBehaviors(),X={cardCount:1,rowHeightPx:{C4:(0,W.P)(2),C3:(0,W.P)(2),C2:(0,W.P)(2),C1:(0,W.P)(2)},colWidthPx:W.f1,gutterPx:W.iw,cardSlots:[{grid_area:"slot1",layouts:{C4:W.uE._2x_2y,C3:W.uE._2x_2y,C2:W.uE._2x_2y,C1:W.uE._1x_2y},telemetryRowCol:{C4:[1,1],C3:[1,1],C2:[1,1],C1:[1,1]}}],styles:Z},Y=j.A`

:host {
    grid-template-areas:
        "slot1 slot2"
        "slot3 slot4";
}

:host([layout="C1"]) {
    grid-template-areas:
        "slot1"
        "slot2"
        "slot3"
        "slot4";
    grid-auto-columns: auto !important;
}

:host fluent-card,
:host msft-article-card {
    content-visibility: auto;
    height: 98px;
}

:host msft-content-card::part(media-wrapper) {
    margin-inline-end: var(--media-inline-padding, 8px);
    margin-top: 8px;
}

:host msft-content-card::part(heading-container) {
    padding-inline-start: var(--heading-start-padding, 8px);
    padding-inline-end: var(--heading-end-padding, 8px);
    padding-bottom: 0;
    padding-top: 8px;
}

:host msft-attribution {
    margin-bottom: 4px;
}
